<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>systemscope-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="database\MigrationRunner\**" />
    <Content Remove="database\MigrationRunner\**" />
    <EmbeddedResource Remove="database\MigrationRunner\**" />
    <None Remove="database\MigrationRunner\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
  </ItemGroup>

  <Target Name="BuildClient" BeforeTargets="Publish" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec WorkingDirectory="..\systemscope-web" Command="npm ci" />
    <Exec WorkingDirectory="..\systemscope-web" Command="npm run build" />
  </Target>

  <ItemGroup>
    <Content Include="..\systemscope-web\dist\**" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="database\migrations\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
